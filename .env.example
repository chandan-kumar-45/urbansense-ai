# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Backend ---
URBANSENSE_ENVIRONMENT=development

# SQLite (default, zero-install):
URBANSENSE_DATABASE_URL=sqlite:///./urbansense.db
# PostgreSQL + PostGIS (production target):
# URBANSENSE_DATABASE_URL=postgresql+psycopg2://urbansense:password@localhost:5432/urbansense

URBANSENSE_JWT_SECRET_KEY=replace-with-a-long-random-secret
URBANSENSE_JWT_ALGORITHM=HS256
URBANSENSE_JWT_EXPIRE_MINUTES=720

URBANSENSE_CORS_ORIGINS=["http://localhost:5173"]

URBANSENSE_UPLOAD_DIR=./uploads
URBANSENSE_MAX_UPLOAD_SIZE_MB=50

URBANSENSE_DEMO_MODE_DEFAULT=true

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
